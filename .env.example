# Copy this file to backend/.env (or .env at the repo root) and fill in real values.
# backend/app/config.py refuses to start the app if SECRET_KEY is left at its insecure
# default, so that one is not optional.

# --- Required ---

# Postgres in production; sqlite:///./aivana.db works for local dev with no setup.
DATABASE_URL=postgresql://user:password@host:5432/aivana

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-real-random-64-char-hex-secret

# --- JWT (defaults are usually fine) ---
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- OPD voice-drafted consultations (scribe.py) ---
# Required for POST /api/scribe, /api/clinical-helper, /api/translate, and the "whisper"
# transcription provider. Leave blank to disable voice drafting (OPD structured-form entry
# still works without it).
GROQ_API_KEY=
# Optional higher-rate-limit key; used instead of GROQ_API_KEY when set.
GROQ_API_KEY_Prod=
GROQ_MODEL=openai/gpt-oss-120b

# --- Audio transcription provider (Sarvam AI) ---
# Purpose-built for Indian clinical Hindi/English code-switched voice transcription.
TRANSCRIPTION_PROVIDER=sarvam
SARVAM_API_KEY=your_sarvam_api_key_here
# Finalized/tested model for Sarvam's Batch Speech-to-Text API (sarvam_batch_transcriber.py).
# mode=translate (always-English output) only takes effect on saaras:v3/v4.
SARVAM_STT_MODEL=saaras:v3

# --- Document OCR (ocr_service.py) ---
# "sarvam" (Sarvam Document AI) when SARVAM_API_KEY is set, else "local" (RapidOCR) automatically
# -- leave unset to get that default; set explicitly to force one or the other.
OCR_PROVIDER=
# BCP-47 language of the documents you expect to upload. Sarvam Document AI has no separate
# "model" setting -- this is the one real tuning knob it exposes.
SARVAM_OCR_LANGUAGE=en-IN

# --- CORS ---
# Default is "*" to allow access from any domain or local dev port.
# You can restrict to comma-separated domains (e.g. "https://your-domain.onrender.com") if desired.
ALLOWED_ORIGINS=*

# --- Misc ---
RATE_LIMIT_ENABLED=true
MAX_PATIENT_DOCUMENT_MB=25

# --- First Admin account (optional) ---
# Auto-seeded on a fresh (empty) database at startup. Leave both blank to skip the seed and
# register the first Admin manually via POST /api/auth/register instead.
ADMIN_EMAIL=admin@aivana.com
ADMIN_PASSWORD=Demo@123456
ADMIN_ORG_NAME=Default Organization
