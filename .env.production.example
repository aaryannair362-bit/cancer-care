# ==============================================================================
# AIvana OS — Production Environment Configuration (.env.production.example)
# Set these in your Render Dashboard / Cloud Provider Environment Settings
# ==============================================================================

# --- Database ---
# PostgreSQL connection string (Supabase / Render Postgres / AWS RDS)
DATABASE_URL=postgresql://user:password@host:5432/aivana_production

# --- Security & JWT ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-real-random-64-char-hex-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Clinical LLM Scribe (Groq) ---
# Used for OPD SOAP consultation structuring, medical extraction & advice synthesis
GROQ_API_KEY=gsk_your_production_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Dedicated key for PDF/document OCR AI-extraction (cca_engine.py), on a SEPARATE Groq account
# from GROQ_API_KEY above so a multi-page document upload's token usage never competes with a
# live consultation's own scribing calls for the same 8000-token/minute account budget. Falls
# back to GROQ_API_KEY when left blank.
GROQ_API_KEY_OCR=gsk_your_production_groq_ocr_api_key_here

# --- Speech-to-Text / Audio Transcription (Sarvam AI) ---
# Purpose-built for Indian clinical settings with Hindi/English medical code-switching
TRANSCRIPTION_PROVIDER=sarvam
# Shared legacy fallback -- only consulted when one of the dedicated keys below isn't set.
SARVAM_API_KEY=sk_your_production_sarvam_api_key_here
# Dedicated per-feature Sarvam keys (recommended): OCR (Document AI) and STT (Scribe's audio
# transcription) are billed/rate-limited independently on Sarvam's side per key. Each falls
# back to the shared SARVAM_API_KEY above when left blank.
SARVAM_OCR_API_KEY=sk_your_production_sarvam_ocr_api_key_here
SARVAM_STT_API_KEY=sk_your_production_sarvam_stt_api_key_here
# Finalized/tested model for Sarvam's Batch Speech-to-Text API. mode=translate (always-English
# output) only takes effect on saaras:v3/v4 -- do not change without verifying that still holds.
SARVAM_STT_MODEL=saaras:v3

# --- Document OCR (Sarvam Document AI) ---
# "sarvam" when SARVAM_OCR_API_KEY (or the shared SARVAM_API_KEY) is set, else "local" (RapidOCR)
# automatically -- leave unset for that default.
OCR_PROVIDER=
# BCP-47 language of the documents you expect to upload. Sarvam Document AI has no separate
# model setting -- this is the one real tuning knob it exposes.
SARVAM_OCR_LANGUAGE=en-IN

# --- CORS & Origins ---
ALLOWED_ORIGINS=*

# --- Operational Controls ---
RATE_LIMIT_ENABLED=true
MAX_PATIENT_DOCUMENT_MB=25

# --- Initial Seed Admin ---
ADMIN_EMAIL=admin@aivana.com
ADMIN_PASSWORD=Demo@123456
ADMIN_ORG_NAME=AIvana Cancer Care Hospital
